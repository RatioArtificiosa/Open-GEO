{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-geo-landing",
  "compatibility_date": "2026-02-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "vars": { "FREE_TOOLS_DAILY_BUDGET_USD": "100" },
  "durable_objects": {
    "bindings": [
      { "name": "FREE_TOOL_BUDGET", "class_name": "FreeToolBudget" },
    ],
  },
  "migrations": [
    { "tag": "free-tool-budget-v1", "new_sqlite_classes": ["FreeToolBudget"] },
  ],
  "assets": {
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "routes": [
    {
      "pattern": "opengeo.so",
      "custom_domain": true,
    },
    {
      "pattern": "www.opengeo.so",
      "custom_domain": true,
    },
  ],
  "ratelimits": [
    {
      "name": "BACKLINK_CHECK_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "env": {
    // Bindings are not inherited by named envs; keep preview's copies in sync.
    "preview": {
      "name": "open-geo-landing-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      // Preview has its own budget; it cannot consume the production allowance.
      "vars": { "FREE_TOOLS_DAILY_BUDGET_USD": "10" },
      "durable_objects": {
        "bindings": [
          { "name": "FREE_TOOL_BUDGET", "class_name": "FreeToolBudget" },
        ],
      },
      "ratelimits": [
        {
          "name": "BACKLINK_CHECK_RATE_LIMIT",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
    },
  },
}
