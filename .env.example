# -----------------------------------------------------------------------------
# Core settings
# -----------------------------------------------------------------------------
# Required for SEO data features. See docs/DATAFORSEO_API_KEY.md.
# DATAFORSEO_API_KEY=

# Optional app port
# PORT=3001

# Optional reverse-proxy hosts for Docker self-hosting
# ALLOWED_HOST=yourdomain.com

# Optional image tag override for Docker self-hosting
# OPEN_SEO_IMAGE=ghcr.io/RatioArtificiosa/Open-GEO:latest

# -----------------------------------------------------------------------------
# Auth mode
# -----------------------------------------------------------------------------
# - cloudflare_access: validate Cloudflare Access JWTs (recommended for deploys)
# - local_noauth: local trusted mode with injected admin user (admin@localhost)
# - hosted: Better Auth email/password + organization mode
#
# Defaults to cloudflare_access when unset.
# AUTH_MODE=cloudflare_access

# Required when AUTH_MODE=cloudflare_access. See docs/SELF_HOSTING_CLOUDFLARE.md.
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-cloudflare-access-aud-tag

# Required when AUTH_MODE=hosted
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# BETTER_AUTH_URL=http://localhost:3001
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# POSTHOG_PUBLIC_KEY=replace-with-your-posthog-project-api-key
# POSTHOG_HOST=https://us.i.posthog.com
# LOOPS_API_KEY=replace-with-your-loops-api-key
# LOOPS_TRANSACTIONAL_VERIFY_EMAIL_ID=replace-with-your-loops-verify-template-id
# LOOPS_TRANSACTIONAL_RESET_PASSWORD_ID=replace-with-your-loops-reset-template-id
# LOOPS_TRANSACTIONAL_INVITATION_ID=replace-with-your-loops-invitation-template-id

# Optional in self-hosted modes. Required if you want AI features like SAM,
# the in-app SEO agent. Create a key at https://openrouter.ai/settings/keys.
# OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# Optional in self-hosted modes. Required if you want Google Search Console
# integration and MCP tools. BETTER_AUTH_SECRET is also required for GSC (it
# encrypts the stored OAuth tokens). See docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md.
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# -----------------------------------------------------------------------------
# Demo mode — see the product before you have a DataForSEO key
# -----------------------------------------------------------------------------
# With DEMO_MODE=true the DataForSEO client returns realistic fixture data
# instead of calling the API, so `docker compose up` shows a populated product
# with no account and no cost. Every demo response is flagged, so the UI badges
# it and demo numbers are never billed or persisted as real.
# DEMO_MODE=false

# -----------------------------------------------------------------------------
# Database & cache (self-host; managed in the hosted app)
# -----------------------------------------------------------------------------
# Postgres connection string. Omit for SQLite/D1 (the default self-host path).
# DATABASE_URL=postgres://opengeo:opengeo@localhost:5432/opengeo
#
# Optional Redis for the response cache and rate limiter. Falls back to in-memory.
# DATAFORSEO_CACHE_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# DataForSEO behaviour
# -----------------------------------------------------------------------------
# Point every call at the free sandbox: dummy data, identical response shapes,
# no charges. NEVER enable in production - you would bill real requests for
# fake data.
# DATAFORSEO_SANDBOX=false

# Hard daily ceiling on Live-mode spend, in USD. The client reads
# /v3/appendix/user_data and refuses to issue new Live tasks past the cap.
# A safety rail, not a billing system.
# DFS_LIVE_BUDGET_USD_DAILY=5

# Concurrency ceiling for Live endpoints. DataForSEO's own account limit is 30;
# do not raise this above 30 or requests will be rejected.
# GEO_PATROL_CONCURRENCY=30

# Verbose DataForSEO request/response logging. Never in production.
# DATAFORSEO_DEBUG=false

# -----------------------------------------------------------------------------
# GEO / AI Optimization
# -----------------------------------------------------------------------------
# How long to retain raw AI answers, fan-out queries and citations. Older
# answers are pruned; derived metrics are kept. See docs/METHODOLOGY.md.
# GEO_ANSWER_RETENTION_DAYS=90

# Pin the Labs ETV formula. DataForSEO flips `use_new_etv` to the default
# on 2026-11-01. We version-stamp every stored ETV value so both formulas stay
# comparable, and never chart across the boundary unlabelled.
# Leave unset and OpenGeo resolves it per endpoint and account registration date,
# always sending an explicit flag so a stored value stays reproducible.
# The vendor's parameter is `use_new_etv` — NOT `use_improved_etv`, which appears
# in no documentation page. Historical endpoints are excluded from the new model.
# DFS_USE_NEW_ETV=

# The LLM model catalog is fetched at boot from
# /v3/ai_optimization/{model}/llm_responses/models and cached, so model names are
# never hardcoded. Set to pin the catalog instead.
# GEO_LLM_MODEL_CATALOG_TTL_HOURS=24

# Optional. Where GEO alerts are delivered.
#
# A Discord incoming-webhook URL (Server Settings -> Integrations -> Webhooks).
# With this unset the alerting chain still runs and still records what it would
# have sent - nothing is sent anywhere, and no patrol fails because of it. The
# design reason is in the transport: a missing webhook must not turn a reporting
# failure into a monitoring outage.
#
# Only *losses* are sent here (a dropped mention, a lost citation, a repeated
# sentiment swing). Gains are batched into the weekly digest rather than pushed,
# because a channel that carries only bad news is a channel people mute.
# GEO_ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# -----------------------------------------------------------------------------
# Predictive Center
# -----------------------------------------------------------------------------
# Stored with every forecast so historical forecasts stay comparable when the
# model changes. Bump on any model or feature change.
# FORECAST_MODEL_VERSION=1

# Minimum history required before we publish a forecast, in days. Below this we
# show "collecting data" rather than a number nobody can defend.
# FORECAST_MIN_HISTORY_DAYS=90

# -----------------------------------------------------------------------------
# Hosted-only (ignored in self-host)
# -----------------------------------------------------------------------------
# Autumn handles subscription and usage credits. Self-hosters do not need this.
# AUTUMN_API_KEY=

# -----------------------------------------------------------------------------
# Quick start
# -----------------------------------------------------------------------------
# 1. Get a DataForSEO key: https://app.dataforseo.com/register -> API Access tab
#    It gives you a base64 `login:password`.
# 2. Or skip that for now: set DEMO_MODE=true and explore with seeded data.
# 3. Set AUTH_MODE=local_noauth for a local trial, or cloudflare_access/hosted
# 4. docker compose up   (or see docs/SELF_HOSTING_CLOUDFLARE.md)
# 5. Open http://localhost:3001
#
# Only DATAFORSEO_API_KEY is genuinely required to get live data. Everything
# else has a working default.
