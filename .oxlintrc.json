{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["typescript", "import", "react", "unicorn", "oxc"],
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".output",
    "web",
    "src/routeTree.gen.ts",
    "worker-configuration.d.ts",
    // `badseo/scripts/` is in no TypeScript program. The root tsconfig excludes
    // `badseo/**/*` and the badseo tsconfig's include is `src/**` only, so nothing
    // type-checks these files and tsgolint types every value in them as `any` —
    // which produced 93 type-aware errors that are noise rather than findings.
    //
    // It is a real gap and it is recorded as one: `ci:check` runs
    // `tsc -p badseo/tsconfig.json` and `badseo/scripts/` is not in it, so the
    // directory is unchecked by the type checker and, until the root `scripts`
    // ignore was removed, unlinted as well. Widening the badseo include needs its
    // own pass because the alias these files rely on is not in that config.
    "badseo/scripts"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/jsx-uses-react": "off",
    // Flags mutating .sort(); its suggested .toSorted() fix doesn't compile
    // here (lib is ES2022) — fix with Remeda's sort/sortBy instead.
    "unicorn/no-array-sort": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unnecessary-type-assertion": [
      "error",
      { "checkLiteralConstAssertions": false }
    ],
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "eslint/no-constant-binary-expression": "error",
    "eslint/no-self-assign": "error",
    "eslint/no-unreachable-loop": "error",
    "eslint/no-unsafe-optional-chaining": "error",
    "eslint/complexity": ["error", { "max": 40 }],
    "eslint/max-lines": [
      "error",
      { "max": 400, "skipBlankLines": true, "skipComments": true }
    ],
    "eslint/max-lines-per-function": [
      "error",
      { "max": 320, "skipBlankLines": true, "skipComments": true }
    ],
    "eslint/max-depth": ["error", 4],
    "eslint/max-params": ["error", 5],
    "import/no-cycle": "error",
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/db/d1", "@/db/d1/*", "@/db/pg", "@/db/pg/*"],
            "message": "Import the provider-aware `db` from \"@/db\", tables from \"@/db/schema\", and batched writes via \"@/db/runBatch\". Dialect-specific clients/schemas may only be imported by the seam files in src/db and src/lib/auth.ts, otherwise the code silently bypasses DATABASE_PROVIDER."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/db/**", "src/lib/auth.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    },
    {
      // **A test that audits a dialect must name it.** The GEO-erasure inventory
      // imports `@/db/pg/schema` to check that the Postgres side erases what the
      // SQLite side does, which is the audit rather than a bypass of the
      // provider-aware seam. The rule stays on everywhere it matters, and this is
      // a scoped exemption for the same reason the one above exists: a test that
      // cannot name its own subject cannot test it.
      "files": ["scripts/geo-erasure-inventory.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    },
    {
      // **The price table grows one entry per endpoint, so a logic-file cap
      // misfires on it by construction.** `src/shared/dataforseo-pricing.ts`
      // sat at 399/400 code lines: any new endpoint — the product's normal
      // growth — breaks the build without anything getting worse. Splitting
      // the table would scatter the single source of truth the quote triple
      // (endpoint path, book entry, test pin) depends on, which trades a
      // green gate for a real defect class. 450 fits ~8 more entries; the
      // 400 cap in `src/**` is untouched, and entries stay reviewable
      // because each is one typed row (`satisfies DfsPrice` — untyped rows
      // like the old `perItem` shape fail the typecheck instead of billing
      // wrong).
      "files": ["src/shared/dataforseo-pricing.ts"],
      "rules": {
        "eslint/max-lines": [
          "error",
          { "max": 450, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    {
      // **`scripts/**` has a higher line cap, and the reason is the kind of file
      // they are.** `src/**` is the product, where 400 lines is a real signal: a
      // source file over it is usually several responsibilities. This directory
      // holds one-off CLI tools (`erase-user-data`, `d1-default-project-cleanup`),
      // migrations that walk a whole table set, and long gate suites — files
      // organised around one procedure with cases rather than around a component.
      //
      // **Decided rather than accepted.** The alternative was extracting the four
      // flagged files, and reading them said that would have meant splitting
      // single-purpose CLI tools into fragments whose only shared surface is a
      // set of locals. 700 is above every current file, so a script that outgrew
      // it would still be caught, and the cap in `src/**` is untouched.
      "files": ["scripts/**", "badseo/scripts/**"],
      "rules": {
        "eslint/max-lines": [
          "error",
          { "max": 700, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    {
      // **The scripts/ directory was not linted at all until 2026-10-11**, and the
      // gap was structural rather than deliberate: `ignorePatterns` named it, so
      // oxlint reported "Finished on 0 files" for the directory holding four of
      // this repository's gates. Removing that entry found dead code, a closure
      // that should have been module-scoped, and two mutating sorts — which is
      // three more real findings than the rest of the repository produced.
      //
      // It also produced 190 `typescript/no-unsafe-*` errors, and those are noise.
      // The rules need a type program, and `tsconfig.json` includes `**/*.ts`
      // only: zero `.mjs` files are in the program, so tsgolint types every value
      // in them as `any` and then flags the file for touching it. The same rules
      // stay on for `scripts/**/*.ts`, which IS in the program and is where they
      // are worth having.
      //
      // The distinction is not "loosen for JS". The syntax-based rules below —
      // `unicorn/no-array-sort`, `no-unused-vars`, `max-lines`, `consistent-function-scoping`
      // — do not need types and are what found the real defects here.
      "files": ["scripts/**/*.mjs", "**/*.mjs"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/no-base-to-string": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unnecessary-type-arguments": "off",
        "typescript/unbound-method": "off"
      }
    }
  ]
}
